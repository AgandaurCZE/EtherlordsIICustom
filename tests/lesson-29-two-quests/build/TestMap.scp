-- LESSON 25: Moss sample encounter built from the tested Grumble pattern
-- Map position (10,16). Moss belongs to P2, alongside Bee and Grumble.
-- All runtime global scratch variables and stored state are Moss-prefixed.

function Moss_OnStep()
    moss_state = ExGetVariable("MossChoiceState")
    moss_hero = ExGetMainHeroID()

    if moss_state == "Cooling" then
        if CalcDistanceObjectPoint(moss_hero, 10, 16) >= 3 then
            ExSetVariable("MossChoiceState", "Ready")
            ExMessageToScreen("MOSS RESET: Encounter rearmed")
        end
        return
    end
    if moss_state ~= nil and moss_state ~= "Ready" then
        return
    end
    if CalcDistanceObjectPoint(moss_hero, 10, 16) >= 3 then
        return
    end

    -- Guard against overlapping scripted cinematics.
    moss_bee_state = ExGetVariable("BeeChoiceState")
    if moss_bee_state == "Intro" or moss_bee_state == "Question"
       or moss_bee_state == "Hostile" or moss_bee_state == "Charging" then
        return
    end
    moss_grumble_state = ExGetVariable("GrumbleChoiceState")
    if moss_grumble_state == "Intro" or moss_grumble_state == "Question"
       or moss_grumble_state == "Hostile" or moss_grumble_state == "Charging" then
        return
    end

    moss_id = nil
    moss_distance = 9999
    for moss_index = 0, ExGetMobCount() - 1 do
        moss_candidate = ExGetMobByIndex(moss_index)
        moss_current_distance = CalcDistanceObjectPoint(
            moss_candidate, 10, 16
        )
        if moss_current_distance < moss_distance then
            moss_id = moss_candidate
            moss_distance = moss_current_distance
        end
    end
    if moss_id == nil or moss_distance > 2 then
        ExSetVariable("MossChoiceState", "NotFound")
        ExMessageToScreen("MOSS ERROR: Cannot find monster near (10,16)")
        return
    end

    moss_home_x, moss_home_y = ExGetPos(moss_id)
    moss_start_x, moss_start_y = ExGetPos(moss_hero)
    ExSetVariable("MossRuntimeId", moss_id)
    ExSetVariable("MossHomeX", moss_home_x)
    ExSetVariable("MossHomeY", moss_home_y)
    ExSetVariable("MossHeroStartX", moss_start_x)
    ExSetVariable("MossHeroStartY", moss_start_y)
    ExSetVariable("MossChoiceState", "Intro")

    ExSoftAbortCmd(moss_hero)
    ExAbortAllCommand()
    ExAddCommandText(moss_id, "Oh! Someone's walking through my mushroom patch!", 0)
    ExAddCommandText(moss_hero, "I didn't mean to disturb your garden.", 0)
    ExAddCommandText(moss_id, "Will you protect these mushrooms, or trample them?", 0)
    ExAddCommandExecuteScriptFunction("Moss_AskQuestion")
end

function Moss_AskQuestion()
    ExSetVariable("MossChoiceState", "Question")
    ExAddCommandQuestion(
        ExGetMainHeroID(),
        "What do you promise Moss?\n\nYES = Protect the mushrooms\nNO = Trample the mushrooms",
        0
    )
end

function Moss_OnCloseMessageBox(callback)
    if ExGetVariable("MossChoiceState") ~= "Question" then
        return
    end
    if callback == "OK" then
        ExSetVariable("MossChoiceState", "Peaceful")
        -- Shared P2 faction stays hostile; peaceful state is object-specific.
        ExAddCommandText(ExGetMainHeroID(), "I'll leave every mushroom untouched.", 0)
        ExAddCommandText(
            ExGetVariable("MossRuntimeId"),
            "Oh, wonderful! The mushrooms thank you!", 0
        )
    else
        ExSetVariable("MossChoiceState", "Hostile")
        -- Shared P2 faction stays hostile; do not change faction hostility.
        ExAddCommandText(ExGetMainHeroID(), "These mushrooms look like excellent stepping stones!", 0)
        ExAddCommandText(
            ExGetVariable("MossRuntimeId"),
            "Not one step further! Defend the mushroom kingdom!", 0
        )
        ExAddCommandExecuteScriptFunction("Moss_LaunchAttack")
    end
end

function Moss_LaunchAttack()
    moss_id = ExGetVariable("MossRuntimeId")
    moss_hero = ExGetMainHeroID()
    if moss_id == nil then
        return
    end
    ExSetVariable("MossChoiceState", "Charging")
    ExAddCommandMobOrientToObject(moss_id, moss_hero)
    ExAddCommandCameraToObject(moss_id, 0)
    moss_attack_id = ExAddCommandMoveAndUseObject(
        moss_id, moss_hero
    )
    ExSetVariable("MossAttackCommand", moss_attack_id)
end

function Moss_IsBattle(attacker_id, target_id)
    moss_id = ExGetVariable("MossRuntimeId")
    if moss_id == nil then
        return 0
    end
    if attacker_id == moss_id or target_id == moss_id then
        return 1
    end
    return 0
end

function Moss_OnBattleFinishing(attacker_id, target_id, winner_id)
    moss_id = ExGetVariable("MossRuntimeId")
    moss_hero = ExGetMainHeroID()
    if moss_id == nil then
        return 1
    end
    if ExGetVariable("MossChoiceState") ~= "Charging" then
        return 1
    end

    ExMessageToScreen(
        "MOSS BATTLE: W=" .. tostring(winner_id)
    )
    if winner_id == moss_hero then
        ExSetVariable("MossChoiceState", "Completed")
        ExMessageToScreen("MOSS: Hero won the battle")
        return 1
    end

    -- Same confirmed battle-refusal reset pattern as Lesson 19.
    ExSetVariable("MossChoiceState", "Cooling")
    moss_home_x = ExGetVariable("MossHomeX")
    moss_home_y = ExGetVariable("MossHomeY")
    moss_start_x = ExGetVariable("MossHeroStartX")
    moss_start_y = ExGetVariable("MossHeroStartY")

    if moss_home_x ~= nil and moss_home_y ~= nil then
        ExJumpToPos(moss_id, moss_home_x, moss_home_y)
        ExMessageToScreen("MOSS RESET: Returned home")
    end
    if moss_start_x ~= nil and moss_start_y ~= nil then
        ExJumpToPos(moss_hero, moss_start_x, moss_start_y)
    end
    ExAddCommandCameraToObject(moss_hero, 0)
    return 0
end

function Moss_OnPreUse(object_id, hero_id)
    if ExGetVariable("MossChoiceState") ~= "Peaceful" then
        return nil
    end
    if object_id == ExGetVariable("MossRuntimeId") then
        if ExGetVariable("HoneyQuestSkipMossGreeting") == 1 then
            ExSetVariable("HoneyQuestSkipMossGreeting", 0)
            return 0
        end
        ExMessageToScreen("MOSS TEST: Peaceful PreUse intercepted")
        return SporeQuest_MossInteraction(object_id, hero_id)
    end
    return nil
end

-- Lesson 25: self-register by callback names (save/load-safe).
EncounterRegistry_Register("Moss", "MossRuntimeId", "MossChoiceState",
    "Moss_OnStep", "Moss_OnCloseMessageBox",
    "Moss_OnBattleFinishing", "Moss_OnPreUse")
-- END

-- BEGIN src/quests/missing_honey.lua
-- LESSON 27: The Queen's Missing Honey.
-- Quest coordination only. Encounter combat/reward functions stay unchanged.
-- All durable quest state lives in ExSetVariable (not Lua tables/functions).
--
-- Stages: nil = not started, 1 = investigate Grumble,
--         2 = recover honey from Moss, 3 = return to Bee, 4 = complete.
-- Peaceful OR Completed (hero won combat) counts as resolved.
-- Refusing a battle / Cooling / Ready does NOT count.

function HoneyQuest_BeeInteraction(object_id, hero_id)
    honey_stage = ExGetVariable("HoneyQuestStage")
    if honey_stage == nil then
        ExSetVariable("HoneyQuestStage", 1)
        ExAddCommandText(object_id,
            "BZZ! I need your help. Someone stole my royal honey!", 1)
        ExAddCommandText(object_id,
            "Question Grumble. He was seen by my hive!", 1)
        ExAddCommandText(hero_id,
            "I will investigate the missing honey, Your Buzziness.", 1)
        ExMessageToScreen("QUEST: Missing Honey - Question Grumble")
        ExAddCommandExecuteScriptFunction("HoneyJournal_Stage1")
        return 0
    end
    if honey_stage == 1 then
        ExAddCommandText(object_id,
            "BZZ! Grumble knows something. Please question him!", 0)
        return 0
    end
    if honey_stage == 2 then
        ExAddCommandText(object_id,
            "BZZ! Find Moss! My royal honey is still missing!", 0)
        return 0
    end
    if honey_stage == 3 then
        -- Mark paid before triggering reward commands to prevent duplicates
        -- across interrupted dialogs, saving/loading, or repeated clicks.
        ExSetVariable("HoneyQuestStage", 4)
        ExAddCommandText(hero_id,
            "Moss had the honey. I have brought it back!", 1)
        ExAddCommandText(object_id,
            "BZZZZ! The hive is saved! Accept my royal reward!", 1)
        ExAddCommandExecuteScriptFunction("HoneyQuest_Reward")
        ExAddCommandExecuteScriptFunction("HoneyJournal_Stage3")
        ExMessageToScreen("QUEST COMPLETE: The Queen's Missing Honey")
        return 0
    end
    if honey_stage == 4 then
        ExAddCommandText(object_id,
            "BZZ! My royal honey is safe, thanks to you!", 0)
        return 0
    end
    return nil
end

function HoneyQuest_Reward()
    if ExGetVariable("HoneyQuestRewardReceived") == 1 then
        return
    end
    ExSetVariable("HoneyQuestRewardReceived", 1)
    -- A known working spell reward API, separate from BeeGiftReceived.
    ExAddSpell(ExGetMainHeroID(), "ASLT")
    ExStartLootMessage()
    ExAddLootMessageSpell("ASLT")
    ExSendLootMessage()
end

function HoneyQuest_Resolved(state)
    if state == "Peaceful" or state == "Completed" then
        return 1
    end
    return 0
end

function HoneyQuest_OnStep()
    honey_stage = ExGetVariable("HoneyQuestStage")
    if honey_stage == nil or honey_stage == 3 or honey_stage == 4 then
        return
    end

    -- Do not enqueue quest narration in the middle of an encounter's
    -- scripted dialogue, charge or battle transition.
    if ExGetCommandQueueSize() > 0 then
        return
    end
    honey_bee_state = ExGetVariable("BeeChoiceState")
    honey_grumble_state = ExGetVariable("GrumbleChoiceState")
    honey_moss_state = ExGetVariable("MossChoiceState")
    if honey_bee_state == "Intro" or honey_bee_state == "Question"
       or honey_bee_state == "Hostile" or honey_bee_state == "Charging"
       or honey_grumble_state == "Intro" or honey_grumble_state == "Question"
       or honey_grumble_state == "Hostile" or honey_grumble_state == "Charging"
       or honey_moss_state == "Intro" or honey_moss_state == "Question"
       or honey_moss_state == "Hostile" or honey_moss_state == "Charging" then
        return
    end

    -- A previously resolved NPC does not remotely deliver quest clues.
    -- The hero must visit the NPC's area after the quest reaches this stage.
    if honey_stage == 1 and HoneyQuest_Resolved(honey_grumble_state) == 1
       and CalcDistanceObjectPoint(ExGetMainHeroID(), 15, 10) < 3 then
        ExSetVariable("HoneyQuestStage", 2)
        honey_grumble_id = ExGetVariable("GrumbleRuntimeId")
        if honey_grumble_state == "Peaceful" and honey_grumble_id ~= nil then
            -- The movement click which brought the hero here may still
            -- invoke OnPreUse after this queued quest narration.
            -- Consume that extra greeting once, not permanently.
            ExSetVariable("HoneyQuestSkipGrumbleGreeting", 1)
            ExAddCommandText(honey_grumble_id,
                "I traded the Queen's honey to Moss for rare mushrooms!", 0)
        else
            ExAddCommandText(ExGetMainHeroID(),
                "Grumble's belongings reveal a honey trade with Moss.", 0)
        end
        ExMessageToScreen("QUEST: Clue found - Find Moss")
        ExAddCommandExecuteScriptFunction("HoneyJournal_Stage2")
        return
    end

    if honey_stage == 2 and HoneyQuest_Resolved(honey_moss_state) == 1
       and CalcDistanceObjectPoint(ExGetMainHeroID(), 10, 16) < 3 then
        ExSetVariable("HoneyQuestStage", 3)
        ExSetVariable("HoneyQuestHoneyRecovered", 1)
        honey_moss_id = ExGetVariable("MossRuntimeId")
        if honey_moss_state == "Peaceful" and honey_moss_id ~= nil then
            ExSetVariable("HoneyQuestSkipMossGreeting", 1)
            ExAddCommandText(honey_moss_id,
                "The honey? Of course! Please return it to the Queen.", 0)
        else
            ExAddCommandText(ExGetMainHeroID(),
                "I recovered the Queen's honey among Moss's belongings.", 0)
        end
        ExMessageToScreen("QUEST: Honey recovered - Return to Bee")
        ExAddCommandExecuteScriptFunction("HoneyJournal_StageRecovered")
        return
    end
end
-- END

-- BEGIN src/quests/stolen_spores.lua
-- LESSON 29: A second, independent, missable quest.
-- Moss must be peaceful/alive. Bramble at (1,16) is intentionally overwhelming.
-- Durable flags ONLY via ExSetVariable; no Lua function objects in saved state.
-- SporeQuestStage: nil unavailable/not offered, 1 find Bramble,
--   2 return to Moss, 3 complete, 4 failed.
-- Bramble peaceful negotiation is REQUIRED. Victory is not a substitute.

function SporeQuest_MossInteraction(object_id, hero_id)
    spore_stage = ExGetVariable("SporeQuestStage")
    spore_moss_state = ExGetVariable("MossChoiceState")
    spore_bramble_state = ExGetVariable("BrambleChoiceState")

    if spore_moss_state ~= "Peaceful" then
        return nil
    end
    if spore_stage == nil then
        if spore_bramble_state == "Completed" then
            ExSetVariable("SporeQuestStage", 4)
            ExAddCommandText(object_id,
                "Oh no! Bramble is gone. My rare spores are lost forever.", 0)
            ExAddCommandExecuteScriptFunction("SporeJournal_Failed")
            return 0
        end
        ExSetVariable("SporeQuestStage", 1)
        ExAddCommandText(object_id,
            "Bramble stole my rare mushroom spores! Please bring them home.", 1)
        ExAddCommandText(hero_id,
            "I'll search for Bramble. Where is she hiding?", 0)
        ExAddCommandText(object_id,
            "Far to the west, behind the rocks. Please do not fight her!", 0)
        ExAddCommandExecuteScriptFunction("SporeJournal_Accepted")
        ExMessageToScreen("SIDE QUEST: The Stolen Mushroom Spores")
        return 0
    end
    if spore_stage == 1 then
        ExAddCommandText(object_id,
            "Please find Bramble. She hides west behind the rocks.", 0)
        return 0
    end
    if spore_stage == 2 then
        if ExGetVariable("SporeQuestSporesRecovered") ~= 1 then
            return 0
        end
        ExSetVariable("SporeQuestStage", 3)
        ExAddCommandText(hero_id,
            "I convinced Bramble to return your stolen mushroom spores.", 0)
        ExAddCommandText(object_id,
            "My spores! Thank you. These are precious beyond words.", 1)
        ExAddCommandExecuteScriptFunction("SporeQuest_Reward")
        ExAddCommandExecuteScriptFunction("SporeJournal_Completed")
        ExMessageToScreen("SIDE QUEST COMPLETE: The Stolen Mushroom Spores")
        return 0
    end
    if spore_stage == 3 then
        ExAddCommandText(object_id,
            "My mushroom spores are safe. Thank you again!", 0)
        return 0
    end
    if spore_stage == 4 then
        ExAddCommandText(object_id,
            "The spores are lost. There is nothing more we can do.", 0)
        return 0
    end
    return 0
end

function SporeQuest_Reward()
    if ExGetVariable("SporeQuestRewardReceived") == 1 then
        return
    end
    ExSetVariable("SporeQuestRewardReceived", 1)
    -- Known working Etherlords II spell + loot notification.
    ExAddSpell(ExGetMainHeroID(), "ALST")
    ExStartLootMessage()
    ExAddLootMessageSpell("ALST")
    ExSendLootMessage()
end

function SporeQuest_OnStep()
    spore_stage = ExGetVariable("SporeQuestStage")
    if spore_stage == nil or spore_stage == 3 or spore_stage == 4 then
        return
    end

    -- If later campaign mechanics ever allow Moss to die after a truce,
    -- fail gracefully without touching the independent honey quest.
    if ExGetVariable("MossChoiceState") == "Completed" then
        ExSetVariable("SporeQuestStage", 4)
        ExAddCommandExecuteScriptFunction("SporeJournal_Failed")
        ExMessageToScreen("SIDE QUEST FAILED: Moss is gone")
        return
    end

    if ExGetCommandQueueSize() > 0 then
        return
    end

    spore_bramble_state = ExGetVariable("BrambleChoiceState")
    spore_moss_state = ExGetVariable("MossChoiceState")
    spore_bee_state = ExGetVariable("BeeChoiceState")
    spore_grumble_state = ExGetVariable("GrumbleChoiceState")
    if spore_bee_state == "Intro" or spore_bee_state == "Question"
       or spore_bee_state == "Hostile" or spore_bee_state == "Charging"
       or spore_grumble_state == "Intro" or spore_grumble_state == "Question"
       or spore_grumble_state == "Hostile" or spore_grumble_state == "Charging"
       or spore_moss_state == "Intro" or spore_moss_state == "Question"
       or spore_moss_state == "Hostile" or spore_moss_state == "Charging"
       or spore_bramble_state == "Intro" or spore_bramble_state == "Question"
       or spore_bramble_state == "Hostile" or spore_bramble_state == "Charging" then
        return
    end

    if spore_stage == 1 and spore_bramble_state == "Completed" then
        ExSetVariable("SporeQuestStage", 4)
        ExAddCommandText(ExGetMainHeroID(),
            "Bramble was defeated. The fragile spores cannot be recovered.", 0)
        ExAddCommandExecuteScriptFunction("SporeJournal_Failed")
        ExMessageToScreen("SIDE QUEST FAILED: The spores were destroyed")
        return
    end

    if spore_stage == 1 and spore_bramble_state == "Peaceful"
       and CalcDistanceObjectPoint(ExGetMainHeroID(), 1, 16) < 3 then
        ExSetVariable("SporeQuestStage", 2)
        ExSetVariable("SporeQuestSporesRecovered", 1)
        spore_bramble_id = ExGetVariable("BrambleRuntimeId")
        if spore_bramble_id ~= nil then
            ExSetVariable("SporeQuestSkipBrambleGreeting", 1)
            ExAddCommandText(spore_bramble_id,
                "Take the spores back to Moss. Keep our bargain secret.", 0)
        end
        ExAddCommandExecuteScriptFunction("SporeJournal_Recovered")
        ExMessageToScreen("SIDE QUEST: Spores recovered - Return to Moss")
        return
    end
end
-- END

-- BEGIN src/journal/honey_journal.lua
-- LESSON 28 EXPERIMENT: native notebook / Events List.
-- Official editor documentation says ExMessageBoxStandard(message, hero_id)
-- adds an event to the notebook when the hero_id is supplied.
-- This also displays an OK-message: observe whether the user sees both.
-- Save-safe once-only flags; no function/table values in ExSetVariable.

function HoneyJournal_Stage1()
    if ExGetVariable("HoneyJournalEntry1") == 1 then
        return
    end
    ExSetVariable("HoneyJournalEntry1", 1)
    ExMessageBoxStandard(
        "The Queen's Missing Honey: Investigate Grumble. "
        .. "Bluhblah's royal honey has disappeared. "
        .. "Question Grumble about the theft.",
        ExGetMainHeroID()
    )
end

function HoneyJournal_Stage2()
    if ExGetVariable("HoneyJournalEntry2") == 1 then
        return
    end
    ExSetVariable("HoneyJournalEntry2", 1)
    ExMessageBoxStandard(
        "A Suspicious Trade: Find Moss. "
        .. "Grumble traded the Queen's honey to Moss for rare mushrooms. "
        .. "Find Moss and recover the royal honey.",
        ExGetMainHeroID()
    )
end

function HoneyJournal_StageRecovered()
    if ExGetVariable("HoneyJournalRecovered") == 1 then
        return
    end
    ExSetVariable("HoneyJournalRecovered", 1)
    ExMessageBoxStandard(
        "Royal Honey Recovered: Return to the Queen. "
        .. "Moss has surrendered the missing honey. "
        .. "Bring it back to bluhblah for your reward.",
        ExGetMainHeroID()
    )
end

function HoneyJournal_Stage3()
    if ExGetVariable("HoneyJournalEntry3") == 1 then
        return
    end
    ExSetVariable("HoneyJournalEntry3", 1)
    ExMessageBoxStandard(
        "The Royal Honey Returned: Quest complete. "
        .. "The honey has been recovered and returned to bluhblah. "
        .. "The Queen has rewarded her Royal Investigator.",
        ExGetMainHeroID()
    )
end
-- END

-- BEGIN src/journal/spore_journal.lua
-- LESSON 29 side quest journal: native Events List, once per stage.
-- Each ExMessageBoxStandard writes a save-persistent event for the player.

function SporeJournal_Accepted()
    if ExGetVariable("SporeJournalAccepted") == 1 then
        return
    end
    ExSetVariable("SporeJournalAccepted", 1)
    ExMessageBoxStandard(
        "The Stolen Mushroom Spores: Find Bramble. "
        .. "Moss needs rare spores stolen by a powerful thief. "
        .. "Bramble hides behind rocks to the west. Negotiate; do not fight.",
        ExGetMainHeroID()
    )
end

function SporeJournal_Recovered()
    if ExGetVariable("SporeJournalRecovered") == 1 then
        return
    end
    ExSetVariable("SporeJournalRecovered", 1)
    ExMessageBoxStandard(
        "Spores Recovered: Return to Moss. "
        .. "Bramble agreed to surrender the spores peacefully. "
        .. "Bring them back to Moss to finish the side quest.",
        ExGetMainHeroID()
    )
end

function SporeJournal_Completed()
    if ExGetVariable("SporeJournalCompleted") == 1 then
        return
    end
    ExSetVariable("SporeJournalCompleted", 1)
    ExMessageBoxStandard(
        "The Stolen Mushroom Spores: Completed. "
        .. "Moss received her rare spores and rewarded your diplomacy.",
        ExGetMainHeroID()
    )
end

function SporeJournal_Failed()
    if ExGetVariable("SporeJournalFailed") == 1 then
        return
    end
    ExSetVariable("SporeJournalFailed", 1)
    ExMessageBoxStandard(
        "The Stolen Mushroom Spores: Failed. "
        .. "The peaceful path was lost. The rare spores cannot be returned.",
        ExGetMainHeroID()
    )
end
-- END

-- BEGIN src/shared/save_load_diagnostics.lua
-- LESSON 23: passive save/load diagnostics.
-- Temporary Lua globals are not placed into ExSetVariable.
-- This detects initial script execution and observed state transitions.
Lesson23_LastBee = nil
Lesson23_LastGrumble = nil
Lesson23_Initialized = nil

function Lesson23_DiagnosticStep()
    lesson23_bee = ExGetVariable("BeeChoiceState")
    lesson23_grumble = ExGetVariable("GrumbleChoiceState")

    if Lesson23_Initialized == nil then
        Lesson23_Initialized = 1
        ExMessageToScreen(
            "L23 START Bee=" .. tostring(lesson23_bee)
            .. " Grumble=" .. tostring(lesson23_grumble)
            .. " Gift=" .. tostring(ExGetVariable("BeeGiftReceived"))
        )
    end

    if lesson23_bee ~= Lesson23_LastBee then
        Lesson23_LastBee = lesson23_bee
        ExMessageToScreen("L23 STATE Bee=" .. tostring(lesson23_bee))
    end

    if lesson23_grumble ~= Lesson23_LastGrumble then
        Lesson23_LastGrumble = lesson23_grumble
        ExMessageToScreen("L23 STATE Grumble=" .. tostring(lesson23_grumble))
    end
end
-- END

-- BEGIN src/shared/hook_router.lua
-- LESSON 24: unchanged engine API; generic registered encounter routing.
-- Five engine hooks total. No Bee or Grumble references in this file.

function Hook_OnStep()
    Lesson23_DiagnosticStep()
    EncounterRegistry_OnStep()
    HoneyQuest_OnStep()
    SporeQuest_OnStep()
end

function Hook_OnCloseMessageBox(callback)
    EncounterRegistry_OnCloseMessageBox(callback)
end

function Hook_OnBattleFinishing(attacker_id, target_id, winner_id)
    return EncounterRegistry_OnBattleFinishing(
        attacker_id, target_id, winner_id
    )
end

function Hook_OnPreUse(object_id, hero_id)
    return EncounterRegistry_OnPreUse(object_id, hero_id)
end

function Hook_OnIntercept(hero_id, interceptor_id)
    return EncounterRegistry_OnIntercept(hero_id, interceptor_id)
end
-- END
