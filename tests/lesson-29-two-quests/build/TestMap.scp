-- GENERATED: Lesson 29 Dual Quests (Lua 4).
-- Four encounters, two independent quests, native notebook.

-- BEGIN src/shared/encounter_registry.lua
-- LESSON 24: Lua 4 compatible encounter registry.
-- Store only callback names (strings), NOT function references in tables.
-- Lua 4 save/load can restore registry data without restoring function fields.
-- Resolve global functions dynamically with Lua 4 getglobal(name).
-- Load this module BEFORE any encounter source registers itself.
EncounterRegistry_Entries = {}
EncounterRegistry_Count = 0

function EncounterRegistry_Register(name, runtime_key, state_key,
    on_step_name, on_close_name, on_battle_name, on_preuse_name)
    EncounterRegistry_Count = EncounterRegistry_Count + 1
    EncounterRegistry_Entries[EncounterRegistry_Count] = {
        name = name,
        runtime_key = runtime_key,
        state_key = state_key,
        on_step_name = on_step_name,
        on_close_name = on_close_name,
        on_battle_name = on_battle_name,
        on_preuse_name = on_preuse_name
    }
end

-- Never store a function in an encounter entry: retrieve it from the global
-- function namespace at the moment it is needed.
function EncounterRegistry_Call(name, a, b, c)
    registry_callback = getglobal(name)
    if type(registry_callback) ~= "function" then
        ExMessageToScreen("REGISTRY ERROR: " .. tostring(name))
        return nil
    end
    return registry_callback(a, b, c)
end

function EncounterRegistry_OnStep()
    for registry_index = 1, EncounterRegistry_Count do
        registry_entry = EncounterRegistry_Entries[registry_index]
        EncounterRegistry_Call(registry_entry.on_step_name)
    end
end

function EncounterRegistry_OnCloseMessageBox(callback)
    -- Keep former behavior: each handler ignores callbacks unless
    -- its own state is "Question".
    for registry_index = 1, EncounterRegistry_Count do
        registry_entry = EncounterRegistry_Entries[registry_index]
        EncounterRegistry_Call(registry_entry.on_close_name, callback)
    end
end

function EncounterRegistry_OnBattleFinishing(attacker_id, target_id, winner_id)
    -- Preserve Lesson 23 dispatch priority: Grumble (registered second)
    -- before Bee. Only one battle handler is allowed to handle a fight.
    for registry_index = EncounterRegistry_Count, 1, -1 do
        registry_entry = EncounterRegistry_Entries[registry_index]
        registry_id = ExGetVariable(registry_entry.runtime_key)
        if registry_id ~= nil and
           (attacker_id == registry_id or target_id == registry_id) then
            return EncounterRegistry_Call(registry_entry.on_battle_name, attacker_id, target_id, winner_id)
        end
    end
    return 1
end

function EncounterRegistry_OnPreUse(object_id, hero_id)
    -- Preserve Lesson 23 dispatch priority: Bee before Grumble.
    for registry_index = 1, EncounterRegistry_Count do
        registry_entry = EncounterRegistry_Entries[registry_index]
        registry_answer = EncounterRegistry_Call(registry_entry.on_preuse_name, object_id, hero_id)
        if registry_answer ~= nil then
            return registry_answer
        end
    end
    return 1
end

function EncounterRegistry_OnIntercept(hero_id, interceptor_id)
    if hero_id ~= ExGetMainHeroID() then
        return 1
    end

    for registry_index = 1, EncounterRegistry_Count do
        registry_entry = EncounterRegistry_Entries[registry_index]
        registry_id = ExGetVariable(registry_entry.runtime_key)
        if registry_id ~= nil and interceptor_id == registry_id and
           ExGetVariable(registry_entry.state_key) == "Peaceful" then

            registry_debug_key = registry_entry.name .. "InterceptDebug"
            if ExGetVariable(registry_debug_key) ~= 1 then
                ExSetVariable(registry_debug_key, 1)
                ExMessageToScreen(
                    registry_entry.name ..
                    " TEST: Peaceful intercept blocked"
                )
            end
            return 0
        end
    end
    return 1
end
-- END

-- BEGIN src/encounters/bee_queen.lua
-- Bee Queen encounter, extracted from working Lesson 19.
-- Only Bee_* functions are defined here; engine hooks live in hook_router.lua.
-- IMPORTANT: keep variable persistence through ExSetVariable/ExGetVariable.

function Bee_OnStep()
    state = ExGetVariable("BeeChoiceState")
    hero_id = ExGetMainHeroID()

    if state == "Cooling" then
        if CalcDistanceObjectPoint(hero_id, 7, 5) >= 3 then
            ExSetVariable("BeeChoiceState", "Ready")
            ExMessageToScreen("BEE RESET: Encounter rearmed")
        end
        return
    end

    if state ~= nil and state ~= "Ready" then
        return
    end

    if CalcDistanceObjectPoint(hero_id, 7, 5) >= 3 then
        return
    end

    bee_id = nil
    bee_distance = 9999
    for i = 0, ExGetMobCount() - 1 do
        mob_id = ExGetMobByIndex(i)
        mob_distance = CalcDistanceObjectPoint(mob_id, 7, 5)
        if mob_distance < bee_distance then
            bee_distance = mob_distance
            bee_id = mob_id
        end
    end

    if bee_id == nil or bee_distance > 2 then
        ExSetVariable("BeeChoiceState", "NotFound")
        ExMessageToScreen("Bee not found!")
        return
    end

    bee_x, bee_y = ExGetPos(bee_id)
    hero_x, hero_y = ExGetPos(hero_id)
    ExSetVariable("BeeRuntimeId", bee_id)
    ExSetVariable("BeeHomeX", bee_x)
    ExSetVariable("BeeHomeY", bee_y)
    ExSetVariable("BeeHeroStartX", hero_x)
    ExSetVariable("BeeHeroStartY", hero_y)
    ExSetVariable("BeeChoiceState", "Intro")

    ExSoftAbortCmd(hero_id)
    ExAbortAllCommand()
    ExAddCommandText(bee_id, "BZZ! You dare enter my sacred kingdom?", 0)
    ExAddCommandText(hero_id, "I was just passing through!", 0)
    ExAddCommandText(bee_id, "Then show some respect to your Queen!", 0)
    ExAddCommandExecuteScriptFunction("Bee_AskQuestion")
end

function Bee_AskQuestion()
    ExSetVariable("BeeChoiceState", "Question")
    ExAddCommandQuestion(
        ExGetMainHeroID(),
        "Will you apologize to the Queen of Bees?\n\nYES = Apologize\nNO = Insult",
        0
    )
end

function Bee_OnCloseMessageBox(callback)
    if ExGetVariable("BeeChoiceState") ~= "Question" then
        return
    end

    if callback == "OK" then
        ExSetVariable("BeeChoiceState", "Peaceful")
        -- Lesson 22: no faction-wide change; keep P1/P2 hostile.
        ExAddCommandText(ExGetMainHeroID(), "Forgive me, Your Buzziness!", 0)
        ExAddCommandText(ExGetVariable("BeeRuntimeId"), "BZZ! Your apology is accepted!", 0)
        ExAddCommandText(ExGetVariable("BeeRuntimeId"), "Take this magical gift from my hive!", 0)
        ExAddCommandExecuteScriptFunction("Bee_GiveGift")
    else
        ExSetVariable("BeeChoiceState", "Hostile")
        -- Lesson 22: P1/P2 remains hostile for native battle initiation.
        ExAddCommandText(ExGetMainHeroID(), "Your honey tastes like swamp water!", 0)
        ExAddCommandText(ExGetVariable("BeeRuntimeId"), "BZZZZ! NOBODY INSULTS MY HONEY!", 0)
        ExAddCommandExecuteScriptFunction("Bee_LaunchAttack")
    end
end

function Bee_GiveGift()
    if ExGetVariable("BeeGiftReceived") == 1 then
        return
    end
    ExSetVariable("BeeGiftReceived", 1)
    gift_roll = 1
    if random ~= nil then
        gift_roll = random(2)
    end
    gift_code = "ALST"
    if gift_roll == 2 then
        gift_code = "ASLT"
    end
    ExAddSpell(ExGetMainHeroID(), gift_code)
    ExStartLootMessage()
    ExAddLootMessageSpell(gift_code)
    ExSendLootMessage()
end

function Bee_LaunchAttack()
    bee_id = ExGetVariable("BeeRuntimeId")
    hero_id = ExGetMainHeroID()
    if bee_id == nil then
        return
    end
    ExSetVariable("BeeChoiceState", "Charging")
    ExAddCommandMobOrientToObject(bee_id, hero_id)
    ExAddCommandCameraToObject(bee_id, 0)
    attack_id = ExAddCommandMoveAndUseObject(bee_id, hero_id)
    ExSetVariable("BeeAttackCommand", attack_id)
end

-- Returns engine 'accept' value (0/1) for this bee battle,
-- or nil if the battle is unrelated. Keep Lesson 19 outcome logic.
function Bee_OnBattleFinishing(attacker_id, target_id, winner_id)
    ExMessageToScreen(
        "BATTLE HOOK: A=" .. tostring(attacker_id) ..
        " T=" .. tostring(target_id) ..
        " W=" .. tostring(winner_id)
    )

    bee_id = ExGetVariable("BeeRuntimeId")
    hero_id = ExGetMainHeroID()

    if bee_id == nil then
        return 1
    end
    if attacker_id ~= bee_id and target_id ~= bee_id then
        return 1
    end
    if ExGetVariable("BeeChoiceState") ~= "Charging" then
        return 1
    end
    if winner_id == hero_id then
        ExSetVariable("BeeChoiceState", "Completed")
        ExMessageToScreen("BEE: Hero won the battle")
        return 1
    end

    ExMessageToScreen("BEE RESET: Beginning rollback")
    ExSetVariable("BeeChoiceState", "Cooling")
    home_x = ExGetVariable("BeeHomeX")
    home_y = ExGetVariable("BeeHomeY")
    start_x = ExGetVariable("BeeHeroStartX")
    start_y = ExGetVariable("BeeHeroStartY")

    if home_x ~= nil and home_y ~= nil then
        ExJumpToPos(bee_id, home_x, home_y)
        ExMessageToScreen("BEE RESET: Queen returned home")
    end
    if start_x ~= nil and start_y ~= nil then
        ExJumpToPos(hero_id, start_x, start_y)
        ExMessageToScreen("BEE RESET: Hero repositioned")
    end
    ExAddCommandCameraToObject(hero_id, 0)
    return 0
end

-- Return nil for unrelated objects. Return 0/1 for handled bee interactions.
function Bee_OnPreUse(object_id, hero_id)
    if ExGetVariable("BeeChoiceState") ~= "Peaceful" then
        return nil
    end
    if object_id == ExGetVariable("BeeRuntimeId") then
        ExMessageToScreen("BEE TEST: Peaceful PreUse intercepted")
        -- Lesson 27: Bee is the quest giver after the original truce.
        return HoneyQuest_BeeInteraction(object_id, hero_id)
    end
    return nil
end

-- Lesson 24: self-register at script initialization.
EncounterRegistry_Register("Bee", "BeeRuntimeId", "BeeChoiceState",
    "Bee_OnStep", "Bee_OnCloseMessageBox", "Bee_OnBattleFinishing", "Bee_OnPreUse")
-- END

-- BEGIN src/encounters/bramble.lua
-- LESSON 29: Bramble, dangerous hidden spore thief. Based on verified encounter mechanics
-- Map position (1, 16). Bramble belongs to P2 with Bee, Grumble and Moss.
-- All runtime global scratch variables and stored state are Bramble-prefixed.

function Bramble_OnStep()
    bramble_state = ExGetVariable("BrambleChoiceState")
    bramble_hero = ExGetMainHeroID()

    if bramble_state == "Cooling" then
        if CalcDistanceObjectPoint(bramble_hero, 1, 16) >= 3 then
            ExSetVariable("BrambleChoiceState", "Ready")
            ExMessageToScreen("BRAMBLE RESET: Encounter rearmed")
        end
        return
    end
    if bramble_state ~= nil and bramble_state ~= "Ready" then
        return
    end
    if CalcDistanceObjectPoint(bramble_hero, 1, 16) >= 3 then
        return
    end

    -- Guard against overlapping scripted cinematics.
    bramble_bee_state = ExGetVariable("BeeChoiceState")
    if bramble_bee_state == "Intro" or bramble_bee_state == "Question"
       or bramble_bee_state == "Hostile" or bramble_bee_state == "Charging" then
        return
    end
    bramble_grumble_state = ExGetVariable("GrumbleChoiceState")
    if bramble_grumble_state == "Intro" or bramble_grumble_state == "Question"
       or bramble_grumble_state == "Hostile" or bramble_grumble_state == "Charging" then
        return
    end

    bramble_moss_state = ExGetVariable("MossChoiceState")
    if bramble_moss_state == "Intro" or bramble_moss_state == "Question"
       or bramble_moss_state == "Hostile" or bramble_moss_state == "Charging" then
        return
    end

    bramble_id = nil
    bramble_distance = 9999
    for bramble_index = 0, ExGetMobCount() - 1 do
        bramble_candidate = ExGetMobByIndex(bramble_index)
        bramble_current_distance = CalcDistanceObjectPoint(
            bramble_candidate, 1, 16
        )
        if bramble_current_distance < bramble_distance then
            bramble_id = bramble_candidate
            bramble_distance = bramble_current_distance
        end
    end
    if bramble_id == nil or bramble_distance > 2 then
        ExSetVariable("BrambleChoiceState", "NotFound")
        ExMessageToScreen("BRAMBLE ERROR: Cannot find monster near (1, 16)")
        return
    end

    bramble_home_x, bramble_home_y = ExGetPos(bramble_id)
    bramble_start_x, bramble_start_y = ExGetPos(bramble_hero)
    ExSetVariable("BrambleRuntimeId", bramble_id)
    ExSetVariable("BrambleHomeX", bramble_home_x)
    ExSetVariable("BrambleHomeY", bramble_home_y)
    ExSetVariable("BrambleHeroStartX", bramble_start_x)
    ExSetVariable("BrambleHeroStartY", bramble_start_y)
    ExSetVariable("BrambleChoiceState", "Intro")

    ExSoftAbortCmd(bramble_hero)
    ExAbortAllCommand()
    ExAddCommandText(bramble_id, "You found my hideout? Not many travelers get this far.", 0)
    ExAddCommandText(bramble_hero, "Moss says you've stolen some rare mushroom spores.", 0)
    ExAddCommandText(bramble_id, "You'll never overpower me. Will you negotiate, or challenge me?", 0)
    ExAddCommandExecuteScriptFunction("Bramble_AskQuestion")
end

function Bramble_AskQuestion()
    ExSetVariable("BrambleChoiceState", "Question")
    ExAddCommandQuestion(
        ExGetMainHeroID(),
        "What will you do?\n\nYES = Negotiate for the spores\nNO = Challenge Bramble",
        0
    )
end

function Bramble_OnCloseMessageBox(callback)
    if ExGetVariable("BrambleChoiceState") ~= "Question" then
        return
    end
    if callback == "OK" then
        ExSetVariable("BrambleChoiceState", "Peaceful")
        -- Shared P2 faction stays hostile; peaceful state is object-specific.
        ExAddCommandText(ExGetMainHeroID(), "Give Moss her spores back. No one needs to fight.", 0)
        ExAddCommandText(
            ExGetVariable("BrambleRuntimeId"),
            "Hah. Sensible. Take the spores, but keep my secret.", 0
        )
    else
        ExSetVariable("BrambleChoiceState", "Hostile")
        -- Shared P2 faction stays hostile; do not change faction hostility.
        ExAddCommandText(ExGetMainHeroID(), "I won't negotiate with a thief!", 0)
        ExAddCommandText(
            ExGetVariable("BrambleRuntimeId"),
            "Then face my strongest spells. I warned you!", 0
        )
        ExAddCommandExecuteScriptFunction("Bramble_LaunchAttack")
    end
end

function Bramble_LaunchAttack()
    bramble_id = ExGetVariable("BrambleRuntimeId")
    bramble_hero = ExGetMainHeroID()
    if bramble_id == nil then
        return
    end
    ExSetVariable("BrambleChoiceState", "Charging")
    ExAddCommandMobOrientToObject(bramble_id, bramble_hero)
    ExAddCommandCameraToObject(bramble_id, 0)
    bramble_attack_id = ExAddCommandMoveAndUseObject(
        bramble_id, bramble_hero
    )
    ExSetVariable("BrambleAttackCommand", bramble_attack_id)
end

function Bramble_IsBattle(attacker_id, target_id)
    bramble_id = ExGetVariable("BrambleRuntimeId")
    if bramble_id == nil then
        return 0
    end
    if attacker_id == bramble_id or target_id == bramble_id then
        return 1
    end
    return 0
end

function Bramble_OnBattleFinishing(attacker_id, target_id, winner_id)
    bramble_id = ExGetVariable("BrambleRuntimeId")
    bramble_hero = ExGetMainHeroID()
    if bramble_id == nil then
        return 1
    end
    if ExGetVariable("BrambleChoiceState") ~= "Charging" then
        return 1
    end

    ExMessageToScreen(
        "BRAMBLE BATTLE: W=" .. tostring(winner_id)
    )
    if winner_id == bramble_hero then
        ExSetVariable("BrambleChoiceState", "Completed")
        ExMessageToScreen("BRAMBLE: Hero won the battle")
        -- Spore quest requires negotiation. Killing the thief destroys that route.
        return 1
    end

    -- Same confirmed battle-refusal reset pattern as Lesson 19.
    ExSetVariable("BrambleChoiceState", "Cooling")
    bramble_home_x = ExGetVariable("BrambleHomeX")
    bramble_home_y = ExGetVariable("BrambleHomeY")
    bramble_start_x = ExGetVariable("BrambleHeroStartX")
    bramble_start_y = ExGetVariable("BrambleHeroStartY")

    if bramble_home_x ~= nil and bramble_home_y ~= nil then
        ExJumpToPos(bramble_id, bramble_home_x, bramble_home_y)
        ExMessageToScreen("BRAMBLE RESET: Returned home")
    end
    if bramble_start_x ~= nil and bramble_start_y ~= nil then
        ExJumpToPos(bramble_hero, bramble_start_x, bramble_start_y)
    end
    ExAddCommandCameraToObject(bramble_hero, 0)
    return 0
end

function Bramble_OnPreUse(object_id, hero_id)
    if ExGetVariable("BrambleChoiceState") ~= "Peaceful" then
        return nil
    end
    if object_id == ExGetVariable("BrambleRuntimeId") then
        if ExGetVariable("SporeQuestSkipBrambleGreeting") == 1 then
            ExSetVariable("SporeQuestSkipBrambleGreeting", 0)
            return 0
        end
        ExMessageToScreen("BRAMBLE TEST: Peaceful PreUse intercepted")
        ExAddCommandText(
            object_id, "We have an understanding. Keep my hiding place secret.", 0
        )
        return 0
    end
    return nil
end

-- Lesson 25: self-register by callback names (save/load-safe).
EncounterRegistry_Register("Bramble", "BrambleRuntimeId", "BrambleChoiceState",
    "Bramble_OnStep", "Bramble_OnCloseMessageBox",
    "Bramble_OnBattleFinishing", "Bramble_OnPreUse")
-- END

